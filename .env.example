PAPER_MCP_MODE=mock
PAPER_MCP_ENDPOINT=http://127.0.0.1:29979/mcp
PAPER_MCP_HEADERS={}
PAPER_MCP_CONNECT_TIMEOUT_MS=8000
SCHEMA_CACHE_TTL_MINUTES=60
